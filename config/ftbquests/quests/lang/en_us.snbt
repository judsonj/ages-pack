	quest.01FD4B4C54A8D62A.title: "Mine Zinc"
	quest.046C91841CECCCD9.quest_desc: ["&eMerge:&r in old dungeon ruins you find drawings of spinning shafts and gears...\\n\\n&bCreate&r runs on &erotation&r: water wheels and windmills spin shafts, and shafts power machines. Here is a wrench to start tinkering."]
	quest.046C91841CECCCD9.title: "Curious Machinery"
