	quest.06DE7FF3D4FB67D4.quest_desc: ["Scale up the farm."]
	quest.06DE7FF3D4FB67D4.title: "Harvest 64 Crops"
	quest.071B437B74E3E579.quest_desc: ["Cook it (or find it). Collect them all."]
	quest.071B437B74E3E579.title: "Nether Salad"
	quest.0749C65C25F08EDE.quest_desc: ["A maze of stone, libraries and traps. Tread carefully."]
